# ============================================================
# Grooted Backend — Environment Variables
# ============================================================

# ─── Database (MongoDB Atlas) ────────────────────────────────
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/grooted_dev?retryWrites=true&w=majority

# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
BASE_URL=https://rootend-dev.dopolabs.com
APP_URL=https://grooted-dev.dopolabs.com

# ─── JWT Authentication ──────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=24h

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,https://grooted-dev.dopolabs.com

# ─── Cloudflare R2 (Image Storage) ──────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=grooted-photos
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ─── Firebase Admin ──────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Sentry ──────────────────────────────────────────────────
SENTRY_DSN=
